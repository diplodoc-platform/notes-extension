{
  "name": "@diplodoc/notes-extension",
  "version": "0.0.0",
  "description": "Notes extension for Diplodoc platform",
  "main": "build/cjs/index.js",
  "types": "build/cjs/plugin/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/plugin/index.d.ts",
        "default": "./build/esm/index.js"
      },
      "require": {
        "types": "./build/cjs/plugin/index.d.ts",
        "default": "./build/cjs/index.js"
      }
    },
    "./plugin": {
      "import": {
        "types": "./build/esm/plugin/pure.d.ts",
        "default": "./build/esm/plugin.js"
      },
      "require": {
        "types": "./build/cjs/plugin/pure.d.ts",
        "default": "./build/cjs/plugin.js"
      }
    },
    "./browser": {
      "import": {
        "types": "./build/esm/browser/index.d.ts",
        "default": "./build/esm/browser.js"
      },
      "require": {
        "types": "./build/cjs/browser/index.d.ts",
        "default": "./build/cjs/browser.js"
      }
    },
    "./runtime": {
      "types": "./build/runtime/index.d.ts",
      "import": "./build/runtime/index.mjs",
      "require": "./build/runtime/index.cjs"
    },
    "./runtime/styles": "./build/runtime/index.css",
    "./runtime/styles.css": "./build/runtime/index.css",
    "./scss/notes": "./build/scss/_notes.scss",
    "./package.json": "./package.json"
  },
  "homepage": "https://diplodoc.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diplodoc-platform/notes-extension.git"
  },
  "bugs": {
    "url": "https://github.com/diplodoc-platform/diplodoc/issues"
  },
  "private": true,
  "author": "",
  "license": "MIT",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "node esbuild/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:package": "node scripts/test-package.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run build && npm run test:package",
    "lint": "eslint src test scripts esbuild && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint src test scripts esbuild --fix && stylelint \"src/**/*.scss\" --fix",
    "pre-commit": "lint-staged",
    "prepare": "husky"
  },
  "devDependencies": {
    "@diplodoc/infra": "2.3.0",
    "@types/node": "22.19.11",
    "esbuild": "0.25.12",
    "husky": "9.1.7",
    "markdown-it": "15.0.3",
    "playwright": "1.60.0",
    "sass": "1.97.3",
    "typescript": "6.0.3",
    "vitest": "3.2.4"
  },
  "module": "build/esm/index.js",
  "peerDependencies": {
    "markdown-it": "^13.0.0 || ^14.0.0 || ^15.0.0"
  }
}
